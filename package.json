{
  "name": "ui",
  "version": "0.1.2",
  "private": true,
  "description": "Plain CSS and JavaScript UI components: no framework, no build step. Dev dependencies are for the tests only.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "lint": "biome lint --error-on-warnings",
    "format": "biome format --write .",
    "check": "biome ci --error-on-warnings . && node scripts/check-version.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "media": "node docs/capture-media.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.63.0",
    "axe-core": "4.10.3"
  }
}
